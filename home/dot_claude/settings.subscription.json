{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_USE_BEDROCK": "",
    "AWS_CONFIG_FILE": "",
    "AWS_ENDPOINT_URL": "",
    "AWS_PROFILE": "",
    "AWS_REGION": ""
  },
  "permissions": {
	"allow": [
		"Bash(git add:*)"
	],
	"ask": [
		"Bash(gh pr create:*)",
		"Bash(git commit:*)"
	],
	"deny": [
		"Read(*.env)",
		"Bash(rm:*)",
		"Bash(curl:*)"
	],
	"defaultMode": "auto"
  },
  "awsAuthRefresh": "",
  "model": "opus[1m]"
}
